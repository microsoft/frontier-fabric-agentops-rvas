table fact_cost
	lineageTag: tbl-fact_cost

	measure 'Total Cost' = SUM(fact_cost[billed_cost])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: meas-total-cost

	measure 'Effective Cost' = SUM(fact_cost[effective_cost])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: meas-effective-cost

	measure 'List Cost' = SUM(fact_cost[list_cost])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: meas-list-cost

	measure 'Cost (USD)' = SUM(fact_cost[billed_cost_usd])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: meas-cost-usd

	measure 'AI Services Cost' = CALCULATE([Total Cost], fact_cost[is_ai_service] = TRUE())
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: meas-ai-services-cost

	measure 'Foundry Models Cost' = CALCULATE([Total Cost], fact_cost[is_foundry_models] = TRUE())
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: meas-foundry-models-cost

	measure 'Cost Lines' = COUNTROWS(fact_cost)
		formatString: #,0
		lineageTag: meas-cost-lines

