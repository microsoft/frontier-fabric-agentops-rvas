table dim_resource
	lineageTag: tbl-dim_resource

	measure Resources = COUNTROWS(dim_resource)
		formatString: #,0
		lineageTag: meas-resources

	measure 'AI Resources' = CALCULATE(COUNTROWS(dim_resource), dim_resource[is_ai_resource] = TRUE())
		formatString: #,0
		lineageTag: meas-ai-resources

	measure 'Governed Resources' = CALCULATE(COUNTROWS(dim_resource), dim_resource[is_governed] = TRUE())
		formatString: #,0
		lineageTag: meas-governed-resources

	measure 'Governance Coverage' = DIVIDE([Governed Resources] + 0, [Resources])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: meas-governance-coverage

	measure 'Owner Tag Coverage' = DIVIDE(CALCULATE(COUNTROWS(dim_resource), dim_resource[has_owner_tag] = TRUE()) + 0, [Resources])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: meas-owner-tag-coverage

