table fact_conversation_steps
	lineageTag: tbl-fact_conversation_steps

	measure Steps = COUNTROWS(fact_conversation_steps)
		formatString: #,0
		lineageTag: meas-steps

	measure 'Step Tokens' = SUM(fact_conversation_steps[total_tokens])
		formatString: #,0
		lineageTag: meas-step-tokens

	measure 'Tool Steps' = CALCULATE(COUNTROWS(fact_conversation_steps), fact_conversation_steps[span_type] IN {"execute_tool", "invoke_tool"})
		formatString: #,0
		lineageTag: meas-tool-steps

	measure 'Distinct Conversations' = DISTINCTCOUNT(fact_conversation_steps[conversation_id])
		formatString: #,0
		lineageTag: meas-distinct-conversations

	column event_time
		dataType: dateTime
		formatString: General Date
		lineageTag: col-fact_conversation_steps-event_time
		summarizeBy: none
