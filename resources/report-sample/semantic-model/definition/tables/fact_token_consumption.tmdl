		summarizeBy: none
		sourceColumn: agent_name

	column response_model
		dataType: string
		lineageTag: col-fact_token_consumption-response_model
		summarizeBy: none
		sourceColumn: response_model

	column project_id
		dataType: string
		lineageTag: col-fact_token_consumption-project_id
		summarizeBy: none
		sourceColumn: project_id

	column foundry_account
		dataType: string
		lineageTag: col-fact_token_consumption-foundry_account
		summarizeBy: none
		sourceColumn: foundry_account

	column foundry_project
		dataType: string
		lineageTag: col-fact_token_consumption-foundry_project
		summarizeBy: none
		sourceColumn: foundry_project

	column last_event_time
		dataType: dateTime
		formatString: General Date
		lineageTag: col-fact_token_consumption-last_event_time
		summarizeBy: none
		sourceColumn: last_event_time

	column sum_cached_tokens
		dataType: int64
		formatString: #,0
		lineageTag: col-fact_token_consumption-sum_cached_tokens
		summarizeBy: none
		sourceColumn: sum_cached_tokens

	column sum_input_tokens
		dataType: int64
		formatString: #,0
		lineageTag: col-fact_token_consumption-sum_input_tokens
		summarizeBy: none
		sourceColumn: sum_input_tokens

	column sum_output_tokens
