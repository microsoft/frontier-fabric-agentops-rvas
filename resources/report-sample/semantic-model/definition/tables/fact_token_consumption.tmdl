table fact_token_consumption
	lineageTag: tbl-fact_token_consumption

	measure 'Token Total' = SUM(fact_token_consumption[sum_total_tokens])
		formatString: #,0
		lineageTag: meas-token-total

	measure 'Token Input' = SUM(fact_token_consumption[sum_input_tokens])
		formatString: #,0
		lineageTag: meas-token-input

	measure 'Token Output' = SUM(fact_token_consumption[sum_output_tokens])
		formatString: #,0
		lineageTag: meas-token-output

	measure 'Token Cached' = SUM(fact_token_consumption[sum_cached_tokens])
		formatString: #,0
		lineageTag: meas-token-cached

	measure 'Token Conversations' = DISTINCTCOUNT(fact_token_consumption[conversation_id])
		formatString: #,0
		lineageTag: meas-token-conversations

	measure 'Token Responses' = SUM(fact_token_consumption[response_count])
		formatString: #,0
		lineageTag: meas-token-responses

	measure 'Avg Tokens / Conversation' = DIVIDE([Token Total], [Token Conversations])
		formatString: #,0
		lineageTag: meas-avg-tokens--conversation

	column timeday
		dataType: dateTime
		formatString: Long Date
		lineageTag: col-fact_token_consumption-timeday
		summarizeBy: none
		sourceColumn: timeday

	column conversation_id
		dataType: string
		lineageTag: col-fact_token_consumption-conversation_id
		summarizeBy: none
		sourceColumn: conversation_id

	column agent_id
