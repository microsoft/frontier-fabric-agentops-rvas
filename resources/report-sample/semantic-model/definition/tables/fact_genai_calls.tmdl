table fact_genai_calls
	lineageTag: tbl-fact_genai_calls

	measure 'Total Calls' = COUNTROWS(fact_genai_calls)
		formatString: #,0
		lineageTag: meas-total-calls

	measure Errors = CALCULATE(COUNTROWS(fact_genai_calls), fact_genai_calls[is_error] = TRUE())
		formatString: #,0
		lineageTag: meas-errors

	measure 'Error Rate' = DIVIDE([Errors], [Total Calls])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: meas-error-rate

	measure 'Avg Latency (ms)' = AVERAGE(fact_genai_calls[duration_ms])
		formatString: #,0
		lineageTag: meas-avg-latency-ms

	measure 'Max Latency (ms)' = MAX(fact_genai_calls[duration_ms])
		formatString: #,0
		lineageTag: meas-max-latency-ms

	measure 'Total Tokens' = SUM(fact_genai_calls[total_tokens])
		formatString: #,0
		lineageTag: meas-total-tokens

	measure 'Input Tokens' = SUM(fact_genai_calls[input_tokens])
		formatString: #,0
		lineageTag: meas-input-tokens

	measure 'Output Tokens' = SUM(fact_genai_calls[output_tokens])
		formatString: #,0
		lineageTag: meas-output-tokens

	measure 'Cached Tokens' = SUM(fact_genai_calls[cached_tokens])
		formatString: #,0
		lineageTag: meas-cached-tokens

	measure Conversations = DISTINCTCOUNT(fact_genai_calls[conversation_id])
		formatString: #,0
		lineageTag: meas-conversations

	measure 'Tool Calls' = CALCULATE(COUNTROWS(fact_genai_calls), fact_genai_calls[span_type] IN {"execute_tool", "invoke_tool"})
		formatString: #,0
		lineageTag: meas-tool-calls

