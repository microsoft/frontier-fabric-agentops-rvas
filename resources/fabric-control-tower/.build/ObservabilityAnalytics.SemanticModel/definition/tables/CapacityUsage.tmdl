table CapacityUsage
	lineageTag: tbl-capacity-usage

	column resource_id
		dataType: string
		summarizeBy: none
		sourceColumn: resource_id
		lineageTag: cu-resource-id

	column metric_name
		dataType: string
		summarizeBy: none
		sourceColumn: metric_name
		lineageTag: cu-metric-name

	column avg_value
		dataType: decimal
		formatString: #,0.0000
		summarizeBy: average
		sourceColumn: avg_value
		lineageTag: cu-avg-value

	column max_value
		dataType: decimal
		formatString: #,0.0000
		summarizeBy: max
		sourceColumn: max_value
		lineageTag: cu-max-value

	column p95_value
		dataType: decimal
		formatString: #,0.0000
		summarizeBy: average
		sourceColumn: p95_value
		lineageTag: cu-p95-value

	column earliest_snapshot
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: earliest_snapshot
		lineageTag: cu-earliest-snapshot

	column latest_snapshot
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: latest_snapshot
		lineageTag: cu-latest-snapshot

	column sample_count
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: sample_count
		lineageTag: cu-sample-count

	measure TotalSamples = SUM(CapacityUsage[sample_count])
		formatString: #,0
		lineageTag: m-total-samples

	measure AvgMetricValue = AVERAGE(CapacityUsage[avg_value])
		formatString: #,0.0000
		lineageTag: m-avg-metric-value

	measure MaxMetricValue = MAX(CapacityUsage[max_value])
		formatString: #,0.0000
		lineageTag: m-max-metric-value

	measure CapacityUtilization = AVERAGE(CapacityUsage[avg_value])
		formatString: #,0.0000
		lineageTag: m-capacity-utilization

	measure AgentExecTimeAvgMs = CALCULATE(AVERAGE(CapacityUsage[avg_value]), CapacityUsage[metric_name] = "metrics_agent_fctv6_agent_agent_execution_time_ms")
		formatString: #,0.0
		lineageTag: m-agent-exec-time

	partition CapacityUsage = entity
		mode: directLake
		source
			entityName: gold_capacity_usage
			schemaName: dbo
			expressionSource: 'DirectLake - Observability Analytics'
