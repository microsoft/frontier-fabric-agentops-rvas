table Calendar
	lineageTag: tbl-calendar
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey: true
		formatString: Long Date
		summarizeBy: none
		sourceColumn: [Date]
		lineageTag: cal-date

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Year]
		lineageTag: cal-year

	column Quarter
		dataType: string
		summarizeBy: none
		sourceColumn: [Quarter]
		lineageTag: cal-quarter

	column MonthNumber
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [MonthNumber]
		lineageTag: cal-month-number

	column Month
		dataType: string
		summarizeBy: none
		sourceColumn: [Month]
		sortByColumn: MonthNumber
		lineageTag: cal-month

	column 'Year Month'
		dataType: string
		summarizeBy: none
		sourceColumn: [Year Month]
		lineageTag: cal-year-month

	column Day
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Day]
		lineageTag: cal-day

	column IsWeekend
		dataType: boolean
		summarizeBy: none
		sourceColumn: [IsWeekend]
		lineageTag: cal-is-weekend

	partition Calendar = calculated
		mode: import
		source = ```
				VAR MinDate = DATE(2026, 1, 1)
				VAR MaxDate = DATE(2026, 12, 31)
				RETURN
				    ADDCOLUMNS(
				        CALENDAR(MinDate, MaxDate),
				        "Year", YEAR([Date]),
				        "Quarter", "Q" & QUARTER([Date]),
				        "MonthNumber", MONTH([Date]),
				        "Month", FORMAT([Date], "MMM"),
				        "Year Month", FORMAT([Date], "YYYY-MM"),
				        "Day", DAY([Date]),
				        "IsWeekend", WEEKDAY([Date], 2) >= 6
				    )
				```
