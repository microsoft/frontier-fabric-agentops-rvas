table AgentAnalytics
	lineageTag: tbl-agent-analytics

	column interaction_date
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: interaction_date
		lineageTag: aa-interaction-date

	column topic_classification
		dataType: string
		summarizeBy: none
		sourceColumn: topic_classification
		lineageTag: aa-topic-classification

	column conversation_count
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: conversation_count
		lineageTag: aa-conversation-count

	column interaction_count
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: interaction_count
		lineageTag: aa-interaction-count

	column user_message_count
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: user_message_count
		lineageTag: aa-user-message-count

	column assistant_message_count
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: assistant_message_count
		lineageTag: aa-assistant-message-count

	column avg_message_length
		dataType: decimal
		formatString: #,0.0
		summarizeBy: average
		sourceColumn: avg_message_length
		lineageTag: aa-avg-message-length

	measure ConversationCount = SUM(AgentAnalytics[conversation_count])
		formatString: #,0
		lineageTag: m-conversation-count

	measure InteractionCount = SUM(AgentAnalytics[interaction_count])
		formatString: #,0
		lineageTag: m-interaction-count

	measure UserMessageCount = SUM(AgentAnalytics[user_message_count])
		formatString: #,0
		lineageTag: m-user-message-count

	measure AssistantMessageCount = SUM(AgentAnalytics[assistant_message_count])
		formatString: #,0
		lineageTag: m-assistant-message-count

	measure AvgMessageLength = AVERAGE(AgentAnalytics[avg_message_length])
		formatString: #,0.0
		lineageTag: m-avg-message-length

	partition AgentAnalytics = entity
		mode: directLake
		source
			entityName: gold_agent_analytics
			schemaName: dbo
			expressionSource: 'DirectLake - Observability Analytics'
